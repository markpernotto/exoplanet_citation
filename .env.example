# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/exoplanet_citation?sslmode=require

# dbt connection (parsed from your DATABASE_URL above; dbt-postgres needs them split)
DBT_HOST=ep-xxx.region.aws.neon.tech
DBT_USER=user
DBT_PASSWORD=password
DBT_DBNAME=exoplanet_citation
DBT_PORT=5432
DBT_SCHEMA=public

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=exoplanet-citation-snapshots
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# NASA ADS API token (Phase 2)
ADS_API_TOKEN=your-ads-token

# ── Starfield resolution (local only; optional) ──────────────────────────
# The 3D view's sky is rendered on the server for each host system. Leave
# these blank to match the public site. Restart `make api` after changing.
#
# STARFIELD_WIDTH: sky texture width in pixels (height is always width / 2).
#   Even number from 1024 to 16382 (16382 is the WebP format limit).
#     4096   4K   lighter and faster
#     6144   6K   default
#     8192   8K   needs ~1.3 GB RAM per render
#     16382  16K  sharpest; needs several GB RAM, renders take much longer
# STARFIELD_MAG_CUTOFF: faintest apparent magnitude drawn (default 14.0).
#   Higher means more faint stars; most extra stars past 13 are procedural.
# STARFIELD_WEBP_QUALITY: 1 to 100 (default 95). Lower makes smaller files.
# STARFIELD_WEBP_LOSSLESS: set to 1 to keep every faint star pixel exact.
#   Best for VR headsets, where the sky surrounds you. Files are several
#   times larger, which is fine locally. With lossless on, QUALITY becomes
#   compression effort (higher = smaller file, slower encode).
#   Suggested VR setup: STARFIELD_WIDTH=8192 and STARFIELD_WEBP_LOSSLESS=1.
#
# The browser caches the sky for a day. After changing these, hard-reload
# (or clear site data on a headset) to see the new texture.
STARFIELD_WIDTH=
STARFIELD_MAG_CUTOFF=
STARFIELD_WEBP_QUALITY=
STARFIELD_WEBP_LOSSLESS=

# Polite-pool identification — required by Crossref, encouraged by ADS
USER_AGENT_EMAIL=mark@pernotto.com
USER_AGENT_PROJECT=exoplanet_citation/0.1 (+https://github.com/markpernotto/exoplanet_citation)
