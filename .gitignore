# dbt
target/
dbt_packages/
logs/
.user.yml
profiles.yml
# ...except our project-internal profiles.yml, which is parameterized via env_var()
# and contains no secrets. CI needs this file to be present.
!etl/transform/profiles.yml

# Node / Vite
node_modules/
dist/
.vite/
*.local

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Snapshot data (lives in R2; only manifest is tracked)
# Exception: versioned release snapshots (data/snapshots/vX.Y.Z.sql.gz)
# are tracked, since they are the frozen-DB receipts for tagged releases.
# NB: we use data/snapshots/* (file pattern) rather than data/snapshots/
# (directory pattern) so the !v*.sql.gz re-inclusion below can take
# effect; git ignores directory exclusions in negations.
data/snapshots/*
!data/snapshots/v*.sql.gz
data/archive/
data/unresolved.csv
!data/MANIFEST.jsonl

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Build artifacts
build/
*.egg

